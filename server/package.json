{
  "name": "@jilson/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests",
    "db:pull": "prisma db pull",
    "db:generate": "if grep -qE '^model ' prisma/schema.prisma; then prisma generate; else echo 'No models defined — skipping prisma generate'; fi",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts",
    "db:seed:content": "tsx src/seed-content.ts",
    "email:previa": "tsx src/previa-do-email.ts",
    "auth:generate": "auth generate --config src/lib/auth.ts"
  },
  "dependencies": {
    "@jilson/core": "*",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@sentry/node": "11.9.0",
    "better-auth": "^1.7.13",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "8.7.1",
    "pg": "^8.23.1",
    "prisma": "^7.10.1",
    "resend": "6.34.1",
    "stripe": "23.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "auth": "1.7.13",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
