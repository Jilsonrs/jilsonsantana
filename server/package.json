{
  "name": "@jilson/server",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:changed": "vitest run --changed --passWithNoTests",
    "db:pull": "prisma db pull",
    "db:generate": "if grep -qE '^model ' prisma/schema.prisma; then prisma generate; else echo 'No models defined — skipping prisma generate'; fi",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx src/seed.ts",
    "db:seed:content": "tsx src/seed-content.ts",
    "auth:generate": "auth generate --config src/lib/auth.ts"
  },
  "dependencies": {
    "@jilson/core": "*",
    "@prisma/client": "^5.16.1",
    "@sentry/node": "10.75.3",
    "better-auth": "^1.7.5",
    "dotenv": "^16.4.5",
    "express": "^5.0.1",
    "prisma": "^5.16.1",
    "stripe": "23.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^20.14.10",
    "@types/supertest": "^6.0.3",
    "auth": "1.7.5",
    "supertest": "^7.2.2",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3",
    "vitest": "^3.2.7"
  }
}
