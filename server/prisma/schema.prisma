// Prisma schema — source of truth for all DB models.
// Run "npm --workspace server run db:pull" (with DATABASE_URL set) to sync from the database.
// Run "npm --workspace server run db:generate" after any schema change.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// Phase 2 — content-model enums. Mirror core/src/constants/content.ts 1:1 (the
// shared `as const` values drive client + Zod; these Postgres enums enforce at
// the DB). Keep both sides in lockstep when adding a value.
enum Level {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
  TODOS_OS_NIVEIS // "Todos os níveis" (operador, 28/09/2026)
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Layer {
  UNIVERSAL
  MODERNO
  IA
}

// Os MATERIAIS EXCLUSIVOS do curso, para o quadro "Este curso inclui" (decisão do
// operador, 04/10/2026): lista FIXA, texto global em `common.materiais`. Item novo
// é decisão dele — não um campo de texto.
enum Material {
  BIBLIOTECA_DE_PROMPTS
  APOSTILA
}

// O TIPO de notificação do sino (Bloco E, etapa 4 — decisões do operador,
// 04/10/2026). Hoje só as duas mensagens do curso; anúncio do operador é outro
// bloco, e entra como valor novo.
enum NotificationKind {
  BOAS_VINDAS
  PARABENS
  // O aviso que o operador escreve em Comunicação → Notificações (bloco C1, 06/10/2026).
  AVISO
}

// Para quem vai o aviso (decisões do operador, 06/10/2026): TODOS = todo mundo com
// conta; CURSO = quem já começou aquele curso (`CourseStart`).
enum AnnouncementAudience {
  TODOS
  CURSO
}

enum PlanItemType {
  COURSE
  LESSON
}

// Os dois idiomas da escola. TETO DE DOIS — um terceiro é decisão do operador,
// não "mais um valor" (docs/idiomas.md). Usado por SiteText, Testimonial,
// FaqItem, Course e LearningPlan.
enum Language {
  PT
  EN
}

// Sobrescrita de texto do site, editada pelo operador no /admin.
//
// NÃO é "o texto do site": o texto vive no dicionário em código
// (core/src/i18n/), que é o VALOR DE FÁBRICA. Esta tabela guarda só o que o
// operador mudou — o que vai para a tela é `sobrescrita ?? fábrica`, e a tabela
// nasce vazia (docs/content.md § 16).
//
// A `key` é o caminho no dicionário (`home.hero.subtitle`,
// `home.pricing.features[0]`), e o servidor SÓ aceita chave que exista lá — senão a
// tabela vira lixeira. O prefixo diz a página: `common.*` sai em toda página.
model SiteText {
  id        Int      @id @default(autoincrement())
  key       String
  language  Language
  value     String
  updatedAt DateTime @updatedAt

  @@unique([key, language])
  @@map("site_text")
}

// Depoimentos e perguntas frequentes da home são TABELA, não chave de
// dicionário: são as duas listas que CRESCEM (CLAUDE.md → "Lista que cresce é
// TABELA"), e depoimento sai na hora se a pessoa pedir (docs/content.md) — isso
// não pode esperar deploy.
//
// Cada idioma tem as SUAS linhas: o depoimento em inglês é outra linha, não
// uma tradução pendurada nesta. `status` esconde; tirar de vez (pedido do
// titular, LGPD) é APAGAR a linha — o nome não pode ficar guardado.
// As iniciais do avatar não são coluna: saem do nome na hora de desenhar.
model Testimonial {
  id           Int           @id @default(autoincrement())
  language     Language
  text         String
  name         String
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([language, status, displayOrder])
  @@map("testimonial")
}

model FaqItem {
  id           Int           @id @default(autoincrement())
  language     Language
  question     String
  answer       String
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([language, status, displayOrder])
  @@map("faq_item")
}

// Phase 1: Better Auth tables (user, session, account, verification).
// Models below are generated by the Better Auth CLI — it is the source of truth
// for the BA schema; do not hand-edit these models. Gerar: `npm --workspace server
// run auth:generate` (o pacote `auth`, sucessor oficial do `@better-auth/cli` desde
// o Better Auth 1.5; sempre na MESMA versão do `better-auth` — o teste
// `better-auth-cli.test.ts` reprova se divergirem). Reescreve este arquivo: confira
// o diff e reaplique as notas "REAPLICAR" abaixo. Conferido em 05/10/2026 com a
// 1.7.5: gerado a partir do nosso `auth.ts`, o esquema não muda nenhum campo.
// Legacy tables (users, sessions) live only in the DB and are dropped in this
// phase's migration.

model User {
  id            String           @id
  // DEBT: o Better Auth CLI gera `name` como required (String). Mantido opcional
  // (String?) para respeitar o CLAUDE.md (name opcional — convite corporativo só
  // por e-mail). REAPLICAR `String?` após cada `npm run auth:generate`.
  name          String?
  email         String
  emailVerified Boolean          @default(false)
  image         String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  role          String           @default("member")
  sessions      Session[]
  accounts      Account[]
  // Phase 2 back-relation: a member's saved/cloned trilhas (curated templates
  // have ownerUserId = null and are not listed here). Hand-added like sessions/
  // accounts — REAPPLY after each `npm run auth:generate` (same DEBT note as
  // `name String?` above; the CLI does not emit our relations).
  learningPlans LearningPlan[]
  // Etapa 4 do Bloco U (29/09/2026): as assinaturas desta pessoa. Mesma DEBT
  // das relações acima — REAPLICAR após cada `npm run auth:generate`.
  subscriptions Subscription[]
  // Fase 5 (03/10/2026): as aulas que esta pessoa concluiu. Mesma DEBT das
  // relações acima — REAPLICAR após cada `npm run auth:generate`.
  progress      LessonProgress[]
  // 03/10/2026: o que esta pessoa salvou para depois. Mesma DEBT — REAPLICAR.
  saved         SavedItem[]
  // 04/10/2026: as notificações do sino. Mesma DEBT — REAPLICAR.
  notifications Notification[]
  courseStarts  CourseStart[]

  birthday            String?
  preferredLanguage   String?   @default("pt")
  marketingConsent    Boolean?  @default(false)
  acquisitionSource   String?
  acquisitionCampaign String?
  deletedAt           DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── Phase 2: Content model (Course → Module → Lesson) + Trilhas ──────────────
// Content entities use Int autoincrement IDs (route handlers parse them via the
// shared parseId helper — Block 2). Better Auth tables keep their String IDs.
// RLS is ENABLEd on every table below in the migration (Prisma does not emit it);
// no policies — Prisma connects via a BYPASSRLS role and is the sole accessor.

// A course. The detail page is light by design (catalog, not a heavy sales page):
// most fields are optional, filled per course by the operator. Derived data
// (carga horária, lesson count, 3-camadas grouping) is computed, never stored.
model Course {
  id                  Int            @id @default(autoincrement())
  slug                String         @unique
  title               String
  subtitle            String?
  description         String?
  level               Level?
  learnTags           String[]       @default([]) // "o que você vai aprender" — clickable pills
  requirements        String[]       @default([]) // pré-requisitos, shown openly
  personas            String[]       @default([]) // "pra quem é"
  highlights          Json? // [{ icon, title, text }] — "diferenciais" icon cards
  faq                 Json? // [{ pergunta, resposta }] — optional; renders only if filled
  camadas             Layer[]        @default([]) // which 3-camadas layers this course shows (0–3)
  materiais           Material[]     @default([]) // os materiais exclusivos marcados no passo Publicar (04/10/2026)
  camadaOverride      Json? // per-course layer text override (exception, e.g. N8N)
  thumbnailUrl        String? // catalog/list image
  introVideoId        String? // presentation video (Bunny); non-gated wiring is Phase 3
  // O envio de apresentação EM ANDAMENTO (Bloco U, etapa 2). Existe para a
  // limpeza que o operador pediu em 27/09/2026: reenviar apaga no Bunny o envio
  // que ficou pela metade, e ao terminar apaga o vídeo substituído. Nunca sai
  // numa rota pública.
  introVideoPendingId String?
  // As MENSAGENS do curso (passo Mensagens, 04/10/2026): em branco, nada é
  // enviado. Vão para o sino como CÓPIA (Notification.body).
  welcomeMessage      String? // ao abrir a primeira aula do curso
  congratsMessage     String? // ao concluir todas as aulas
  displayOrder        Int            @default(0)
  status              ContentStatus  @default(DRAFT)
  // O idioma do curso (decisão do operador, 14/09/2026). Obrigatório e SEM
  // default: o banco recusa curso sem idioma. Módulo e aula herdam daqui.
  // Troca só enquanto rascunho (operador, 24/09) — regra no servidor.
  language            Language
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  modules             Module[]
  planItems           PlanItem[]
  saved               SavedItem[]
  introCaption        Caption?
  notifications       Notification[]
  announcements       Announcement[]
  courseStarts        CourseStart[]

  @@map("course")
}

model Module {
  id           Int           @id @default(autoincrement())
  courseId     Int
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  layer        Layer? // optional single layer tag (post-launch: group accordion by it)
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  lessons      Lesson[]

  @@index([courseId])
  @@map("module")
}

// First-class & searchable: a lesson has its own title + tags and can surface in
// search results or sit inside a trilha on its own, not only nested in a course.
// Progress counts per lesson (Phase 5). bunnyVideoId is added in Phase 3.
// O tipo da aula (Bloco E, etapa 2 — operador, 28/09/2026): vídeo ou texto. O
// quiz entra numa etapa própria, como valor novo. Aula de vídeo não tem texto.
enum LessonKind {
  VIDEO
  TEXT
}

model Lesson {
  id                   Int              @id @default(autoincrement())
  moduleId             Int
  module               Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title                String
  kind                 LessonKind       @default(VIDEO)
  // O texto da aula de TEXTO, em Markdown (negrito, itálico e listas). Conteúdo
  // pago: nenhuma rota pública o devolve.
  content              String?
  // O vídeo da aula no Bunny (biblioteca de aulas, com token) e o envio EM
  // ANDAMENTO — a mesma limpeza da apresentação (Bloco U, etapa 3). Nenhuma rota
  // pública devolve os dois: o aluno recebe só o player assinado, na etapa 4.
  // O progresso do aluno fica preso à AULA, nunca a este id (bunny.md §7.1).
  bunnyVideoId         String?
  bunnyVideoPendingId  String?
  // O Bunny já disse que o vídeo está pronto (decisão do operador, 29/09/2026: ao
  // voltar para o editor, a aula pronta volta recolhida). É um LEMBRETE do que o
  // Bunny respondeu, não um dado derivado: sem ele, abrir o editor perguntaria ao
  // Bunny por todas as aulas, toda vez.
  bunnyVideoReady      Boolean          @default(false)
  // A duração do vídeo em segundos (o `length` do Bunny), gravada quando ele fica
  // pronto; a do curso é a soma, nunca coluna (29/09/2026).
  videoDurationSeconds Int?
  // Prévia grátis (operador, 27/09/2026, "como na Udemy"): a aula toca para
  // qualquer visitante. Só é gravada aqui; tocar para visitante é a etapa 4.
  isFreePreview        Boolean          @default(false)
  files                LessonFile[]
  tags                 String[]         @default([])
  displayOrder         Int              @default(0)
  status               ContentStatus    @default(DRAFT)
  planItems            PlanItem[]
  progress             LessonProgress[]
  saved                SavedItem[]
  caption              Caption?

  @@index([moduleId])
  @@map("lesson")
}

// O PROGRESSO do aluno numa aula (Fase 5 — plano aprovado pelo operador em
// 03/10/2026). Uma linha por pessoa e aula; a aula conta como concluída sozinha:
// vídeo ao chegar a 90%, texto ao abrir. Preso à AULA, nunca ao vídeo do Bunny
// (bunny.md §7.1). CHURN NÃO APAGA: perder o acesso não toca nestas linhas
// (CLAUDE.md → Membership Gating); só some com a aula ou com a pessoa.
model LessonProgress {
  id          Int       @id @default(autoincrement())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId    Int
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed   Boolean   @default(false)
  completedAt DateTime?
  // ONDE A PESSOA PAROU (Bloco AULA — plano aprovado pelo operador em 06/10/2026):
  // quem sai e volta — no mesmo aparelho ou em outro, amanhã ou daqui a um ano —
  // abre a MESMA aula, no MESMO segundo. Fica na CONTA, e não no navegador: o
  // Safari apaga o que o site guarda no aparelho depois de 7 dias sem visita.
  // `positionSeconds`: o segundo do vídeo; vazio = viu até o fim (ou aula sem
  // vídeo). `lastSeenAt`: a última vez que a pessoa esteve na aula — é o que diz
  // em que aula ela entra quando volta ao curso. Por isso a linha pode existir
  // SEM estar concluída: quem lê conclusão filtra `completed: true`.
  positionSeconds Int?
  lastSeenAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// O que a pessoa SALVOU para assistir depois — um curso inteiro ou uma aula
// (decisão do operador, 03/10/2026, "como no LinkedIn"; a lista é "Salvos", em
// Meus estudos). Exatamente UM dos dois: o banco recusa os dois juntos ou nenhum
// (CHECK na migration, como no plan_item). Some com o curso, a aula ou a pessoa.
model SavedItem {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  Int?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  Int?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@unique([userId, lessonId])
  @@index([courseId])
  @@index([lessonId])
  @@map("saved_item")
}

// A LEGENDA de uma aula ou da apresentação do curso (passo Legendas do editor —
// decisões do operador, 04/10/2026). Exatamente UM dono: o banco recusa os dois
// ou nenhum (CHECK na migration). O player toca a legenda que está no BUNNY; esta
// é a CÓPIA do site, e é ela que deixa trocar o vídeo sem perder a legenda (o
// site reenvia para o vídeo novo), abrir a tela sem perguntar ao Bunny aula por
// aula, e baixar. Só no idioma do curso. Some com a aula ou o curso.
model Caption {
  id           Int      @id @default(autoincrement())
  lessonId     Int?     @unique
  lesson       Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // A da apresentação do curso.
  courseId     Int?     @unique
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  language     Language
  content      String
  originalName String
  // O vídeo foi trocado e o Bunny recusou receber esta legenda no vídeo novo: a
  // tela pede para enviar de novo, em vez de a legenda sumir em silêncio.
  needsResend  Boolean  @default(false)
  uploadedAt   DateTime @default(now())

  @@map("caption")
}

// Uma NOTIFICAÇÃO do sino (Bloco E, etapa 4 — decisões do operador, 04/10/2026).
// O texto é COPIADO no envio: editar a mensagem do curso depois não muda o que o
// aluno já recebeu. Uma de cada tipo por pessoa e curso (o banco garante: abrir a
// aula dez vezes não manda dez boas-vindas). Boas-vindas e parabéns têm curso
// (CHECK na migration). Some com a pessoa ou o curso.
model Notification {
  id          Int              @id @default(autoincrement())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  courseId    Int?
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  body        String
  // O título do curso NO ENVIO, como o texto: o curso pode sair do ar e ser
  // renomeado em rascunho, e o nome novo não pode vazar pelo sino (achado P1 da
  // revisão de segurança, 04/10/2026).
  courseTitle String?
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  // O aviso de Comunicação de onde esta notificação veio (só no tipo AVISO). O sino
  // lê o título e o texto ATUAIS dele (regra da P46); apagar o aviso apaga daqui.
  announcementId Int?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, kind])
  @@unique([userId, announcementId])
  @@index([userId, createdAt])
  @@index([courseId])
  @@index([announcementId])
  @@map("notification")
}

// O AVISO de Comunicação → Notificações (bloco C1 — decisões do operador, 06/10/2026):
// o operador escreve, escolhe para quem, salva como rascunho ou envia. Enviado,
// pode ser editado (todos passam a ver o texto novo) e apagado (some do sino de
// todos). `sentAt` nulo = rascunho.
model Announcement {
  id            Int                  @id @default(autoincrement())
  title         String
  body          String
  audience      AnnouncementAudience @default(TODOS)
  courseId      Int?
  course        Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sentAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  notifications Notification[]

  @@index([courseId])
  @@map("announcement")
}

// QUEM JÁ COMEÇOU O CURSO (decisão do operador, 06/10/2026): a escola não tem
// matrícula — a assinatura dá acesso a tudo —, então "os alunos de um curso" são
// os que abriram uma aula dele com acesso. Gravado na página da aula; a primeira
// vez fica.
model CourseStart {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_start")
}

// A trilha (learning track). Curated template (ownerUserId = null, isTemplate)
// and a member's personalized/cloned plan are the SAME entity — only ownership
// differs. AI-assembled plans (buildLearningPlan) land in JilsonAI Fase 4–5 with
// no rewrite. skillsCovered is the snapshot the certificate prints.
model LearningPlan {
  id            Int            @id @default(autoincrement())
  slug          String?        @unique // curated templates get a slug; clones may not
  name          String
  description   String?
  ownerUserId   String? // null = curated template
  owner         User?          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  isTemplate    Boolean        @default(false)
  skillsCovered String[]       @default([])
  sourcePlanId  Int? // provenance: which template this clone came from
  sourcePlan    LearningPlan?  @relation("PlanClone", fields: [sourcePlanId], references: [id], onDelete: SetNull)
  clones        LearningPlan[] @relation("PlanClone")
  displayOrder  Int            @default(0)
  status        ContentStatus  @default(DRAFT)
  // A trilha segue o idioma (operador, 14/09): o servidor recusa item de outro
  // idioma. Obrigatório e sem default, como no curso.
  language      Language
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  planModules   PlanModule[]

  @@index([ownerUserId])
  @@map("learning_plan")
}

model PlanModule {
  id           Int          @id @default(autoincrement())
  planId       Int
  plan         LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title        String
  displayOrder Int          @default(0)
  items        PlanItem[]

  @@index([planId])
  @@map("plan_module")
}

// The free mix: an item is EITHER a whole course OR a standalone lesson. A DB
// CHECK constraint (added in the migration) enforces the XOR so itemType always
// matches exactly one populated FK.
model PlanItem {
  id           Int          @id @default(autoincrement())
  planModuleId Int
  planModule   PlanModule   @relation(fields: [planModuleId], references: [id], onDelete: Cascade)
  itemType     PlanItemType
  courseId     Int?
  course       Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     Int?
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  displayOrder Int          @default(0)

  @@index([planModuleId])
  @@index([courseId])
  @@index([lessonId])
  @@map("plan_item")
}

// ARQUIVO PARA BAIXAR de uma aula (Bloco E, etapa 2, parte 2e — decisão do
// operador, 28/09/2026). O arquivo mora numa Storage Zone PRÓPRIA do Bunny, sem
// CDN: nada lá é público, e só o nosso servidor entrega — para o assinante, na
// etapa 4 do Bloco U. O caminho tem nome aleatório (`aulas/<aula>/<código>.<ext>`).
model LessonFile {
  id           Int      @id @default(autoincrement())
  lessonId     Int
  lesson       Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // O nome com que o operador enviou (o aluno baixa com este nome).
  originalName String
  storagePath  String   @unique
  // BigInt: arquivo sem limite de tamanho (operador, 29/09/2026); Int para em 2 GB.
  sizeBytes    BigInt
  createdAt    DateTime @default(now())

  @@index([lessonId])
  @@map("lesson_file")
}

// A ASSINATURA — o ESPELHO local da Subscription da Stripe, que é a canônica
// (CLAUDE.md → Membership Gating). O gate (`temAcessoAtivo`) lê SÓ daqui. Nasce
// na etapa 4 do Bloco U (29/09/2026), adiantada da Fase 4 e ainda sem Stripe: as
// colunas da Stripe já nascem, porque o espelho é delas. Costuras do corporativo
// desde o primeiro dia (`organizationId`, `seats`) e SEM coluna de idioma —
// idioma é filtro, nunca portão (decisão do operador, 14/09/2026).
model Subscription {
  id                   Int       @id @default(autoincrement())
  ownerUserId          String?
  owner                User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  // Sempre vazio antes do corporativo (pós-MVP).
  organizationId       Int?
  seats                Int       @default(1)
  // TEXTO, não enum: a regra do gate não pode quebrar no dia em que a Stripe
  // inventar um status novo (CLAUDE.md → Membership Gating).
  status               String
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  // Obrigatório: é a chave do objeto canônico na Stripe.
  stripeSubscriptionId String    @unique
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([ownerUserId])
  @@map("subscription")
}
