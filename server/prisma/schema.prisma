// Prisma schema — source of truth for all DB models.
// Run "npm --workspace server run db:pull" (with DATABASE_URL set) to sync from the database.
// Run "npm --workspace server run db:generate" after any schema change.

// Prisma 7 (26/10/2026): o cliente é gerado DENTRO do código (`src/generated/prisma`, fora do
// git) e não mais em node_modules; importe de `lib/prisma.ts`. O endereço do banco não mora mais
// aqui: o das migrations está no `prisma.config.ts` (o DIRECT_URL), e o do site vai pelo adaptador
// do `pg` em `lib/prisma.ts` (o DATABASE_URL).
generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

// Phase 2 — content-model enums. Mirror core/src/constants/content.ts 1:1 (the
// shared `as const` values drive client + Zod; these Postgres enums enforce at
// the DB). Keep both sides in lockstep when adding a value.
enum Level {
  INICIANTE
  INTERMEDIARIO
  AVANCADO
  TODOS_OS_NIVEIS // "Todos os níveis" (operador, 28/09/2026)
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum Layer {
  UNIVERSAL
  MODERNO
  IA
}

// Os MATERIAIS EXCLUSIVOS do curso, para o quadro "Este curso inclui" (decisão do
// operador, 04/10/2026): lista FIXA, texto global em `common.materiais`. Item novo
// é decisão dele — não um campo de texto.
enum Material {
  BIBLIOTECA_DE_PROMPTS
  APOSTILA
}

// O TIPO de notificação do sino (Bloco E, etapa 4 — decisões do operador,
// 04/10/2026). Hoje só as duas mensagens do curso; anúncio do operador é outro
// bloco, e entra como valor novo.
enum NotificationKind {
  BOAS_VINDAS
  PARABENS
  // O aviso que o operador escreve em Comunicação → Notificações (bloco C1, 06/10/2026).
  AVISO
}

// Para quem vai o aviso (decisões do operador, 06/10/2026): TODOS = todo mundo com
// conta; CURSO = quem já começou aquele curso (`CourseStart`).
enum AnnouncementAudience {
  TODOS
  CURSO
}

enum PlanItemType {
  COURSE
  LESSON
}

// Sobrescrita de texto do site, editada pelo operador no /admin.
//
// NÃO é "o texto do site": o texto vive no dicionário em código
// (core/src/i18n/), que é o VALOR DE FÁBRICA. Esta tabela guarda só o que o
// operador mudou — o que vai para a tela é `sobrescrita ?? fábrica`, e a tabela
// nasce vazia (docs/content.md § 16).
//
// A `key` é o caminho no dicionário (`home.hero.subtitle`,
// `home.pricing.features[0]`), e o servidor SÓ aceita chave que exista lá — senão a
// tabela vira lixeira. O prefixo diz a página: `common.*` sai em toda página.
model SiteText {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt

  @@map("site_text")
}

// Depoimentos e perguntas frequentes da home são TABELA, não chave de
// dicionário: são as duas listas que CRESCEM (CLAUDE.md → "Lista que cresce é
// TABELA"), e depoimento sai na hora se a pessoa pedir (docs/content.md) — isso
// não pode esperar deploy.
//
// `status` esconde; tirar de vez (pedido do
// titular, LGPD) é APAGAR a linha — o nome não pode ficar guardado.
// As iniciais do avatar não são coluna: saem do nome na hora de desenhar.
model Testimonial {
  id           Int           @id @default(autoincrement())
  text         String
  name         String
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, displayOrder])
  @@map("testimonial")
}

model FaqItem {
  id           Int           @id @default(autoincrement())
  question     String
  answer       String
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, displayOrder])
  @@map("faq_item")
}

// Phase 1: Better Auth tables (user, session, account, verification).
// Models below are generated by the Better Auth CLI — it is the source of truth
// for the BA schema; do not hand-edit these models. Gerar: `npm --workspace server
// run auth:generate` (o pacote `auth`, sucessor oficial do `@better-auth/cli` desde
// o Better Auth 1.5; sempre na MESMA versão do `better-auth` — o teste
// `better-auth-cli.test.ts` reprova se divergirem). Reescreve este arquivo: confira
// o diff e reaplique as notas "REAPLICAR" abaixo. Conferido em 05/10/2026 com a
// 1.7.5: gerado a partir do nosso `auth.ts`, o esquema não muda nenhum campo.
// MEDIDO em 18/10/2026: o comando NÃO apaga campo que saiu do `auth.ts` — só
// acrescenta. Tirar um campo extra é à mão, aqui e numa migration.
// Legacy tables (users, sessions) live only in the DB and are dropped in this
// phase's migration.

model User {
  id             String             @id
  // DEBT: o Better Auth CLI gera `name` como required (String). Mantido opcional
  // (String?) para respeitar o CLAUDE.md (name opcional — convite corporativo só
  // por e-mail). REAPLICAR `String?` após cada `npm run auth:generate`.
  name           String?
  email          String
  emailVerified  Boolean            @default(false)
  image          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  role           String             @default("member")
  sessions       Session[]
  accounts       Account[]
  // Phase 2 back-relation: a member's saved/cloned trilhas (curated templates
  // have ownerUserId = null and are not listed here). Hand-added like sessions/
  // accounts — REAPPLY after each `npm run auth:generate` (same DEBT note as
  // `name String?` above; the CLI does not emit our relations).
  learningPlans  LearningPlan[]
  // Etapa 4 do Bloco U (29/09/2026): as assinaturas desta pessoa. Mesma DEBT
  // das relações acima — REAPLICAR após cada `npm run auth:generate`.
  subscriptions  Subscription[]
  // Fase 5 (03/10/2026): as aulas que esta pessoa concluiu. Mesma DEBT das
  // relações acima — REAPLICAR após cada `npm run auth:generate`.
  progress       LessonProgress[]
  // 03/10/2026: o que esta pessoa salvou para depois. Mesma DEBT — REAPLICAR.
  saved          SavedItem[]
  // 04/10/2026: as notificações do sino. Mesma DEBT — REAPLICAR.
  notifications  Notification[]
  courseStarts   CourseStart[]
  // 07/10/2026 (Bloco AULA, etapa 6): as preferências do aluno (a legenda
  // lembrada). Mesma DEBT — REAPLICAR após cada `npm run auth:generate`.
  preference     StudentPreference?
  // 09/10/2026 (Bloco MEDIR, etapa 1): os eventos do vídeo desta pessoa. Mesma
  // DEBT — REAPLICAR após cada `npm run auth:generate`.
  lessonEvents   LessonEvent[]
  // 10/10/2026 (Fase 4, etapa 4.2): o cliente desta pessoa na Stripe. Mesma DEBT —
  // REAPLICAR após cada `npm run auth:generate`.
  stripeCustomer StripeCustomer?
  // 21/10/2026 (Fase 4, etapa 4.7, passo 4): a ficha de espera de onde esta conta nasceu, se ela
  // nasceu de um pagamento sem conta. Mesma DEBT — REAPLICAR após cada `npm run auth:generate`.
  guestCheckout  GuestCheckout?
  // 31/10/2026 (etapa 4.7b, passo 1f): o registro da cobrança desta pessoa. Mesma DEBT — REAPLICAR após cada
  // `npm run auth:generate`.
  billingLogs    BillingLog[]
  // 31/10/2026 (etapa 4.7b, passo 3c): o pedido de correção do e-mail desta conta, à espera do código. Mesma DEBT —
  // REAPLICAR após cada `npm run auth:generate`.
  emailCorrection EmailCorrection?

  birthday            String?
  marketingConsent    Boolean?  @default(false)
  acquisitionSource   String?
  acquisitionCampaign String?
  deletedAt           DateTime?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ── Phase 2: Content model (Course → Module → Lesson) + Trilhas ──────────────
// Content entities use Int autoincrement IDs (route handlers parse them via the
// shared parseId helper — Block 2). Better Auth tables keep their String IDs.
// RLS is ENABLEd on every table below in the migration (Prisma does not emit it);
// no policies — Prisma connects via a BYPASSRLS role and is the sole accessor.

// A course. The detail page is light by design (catalog, not a heavy sales page):
// most fields are optional, filled per course by the operator. Derived data
// (carga horária, lesson count, 3-camadas grouping) is computed, never stored.
model Course {
  id                  Int            @id @default(autoincrement())
  slug                String         @unique
  title               String
  subtitle            String?
  description         String?
  level               Level?
  learnTags           String[]       @default([]) // "o que você vai aprender" — clickable pills
  requirements        String[]       @default([]) // pré-requisitos, shown openly
  personas            String[]       @default([]) // "pra quem é"
  highlights          Json? // [{ icon, title, text }] — "diferenciais" icon cards
  faq                 Json? // [{ pergunta, resposta }] — optional; renders only if filled
  camadas             Layer[]        @default([]) // which 3-camadas layers this course shows (0–3)
  materiais           Material[]     @default([]) // os materiais exclusivos marcados no passo Publicar (04/10/2026)
  camadaOverride      Json? // per-course layer text override (exception, e.g. N8N)
  thumbnailUrl        String? // catalog/list image
  introVideoId        String? // presentation video (Bunny); non-gated wiring is Phase 3
  // O envio de apresentação EM ANDAMENTO (Bloco U, etapa 2). Existe para a
  // limpeza que o operador pediu em 27/09/2026: reenviar apaga no Bunny o envio
  // que ficou pela metade, e ao terminar apaga o vídeo substituído. Nunca sai
  // numa rota pública.
  introVideoPendingId String?
  // As MENSAGENS do curso (passo Mensagens, 04/10/2026): em branco, nada é
  // enviado. Vão para o sino como CÓPIA (Notification.body).
  welcomeMessage      String? // ao abrir a primeira aula do curso
  congratsMessage     String? // ao concluir todas as aulas
  displayOrder        Int            @default(0)
  status              ContentStatus  @default(DRAFT)
  // O idioma do curso (decisão do operador, 14/09/2026). Obrigatório e SEM
  // default: o banco recusa curso sem idioma. Módulo e aula herdam daqui.
  // Troca só enquanto rascunho (operador, 24/09) — regra no servidor.
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  modules             Module[]
  planItems           PlanItem[]
  saved               SavedItem[]
  introCaption        Caption?
  notifications       Notification[]
  announcements       Announcement[]
  courseStarts        CourseStart[]

  @@map("course")
}

model Module {
  id           Int           @id @default(autoincrement())
  courseId     Int
  course       Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title        String
  layer        Layer? // optional single layer tag (post-launch: group accordion by it)
  displayOrder Int           @default(0)
  status       ContentStatus @default(DRAFT)
  lessons      Lesson[]

  @@index([courseId])
  @@map("module")
}

// First-class & searchable: a lesson has its own title + tags and can surface in
// search results or sit inside a trilha on its own, not only nested in a course.
// Progress counts per lesson (Phase 5). bunnyVideoId is added in Phase 3.
// O tipo da aula (Bloco E, etapa 2 — operador, 28/09/2026): vídeo ou texto. O
// quiz entra numa etapa própria, como valor novo. Aula de vídeo não tem texto.
enum LessonKind {
  VIDEO
  TEXT
}

model Lesson {
  id                   Int              @id @default(autoincrement())
  moduleId             Int
  module               Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title                String
  kind                 LessonKind       @default(VIDEO)
  // O texto da aula de TEXTO, em Markdown (negrito, itálico e listas). Conteúdo
  // pago: nenhuma rota pública o devolve.
  content              String?
  // O vídeo da aula no Bunny (biblioteca de aulas, com token) e o envio EM
  // ANDAMENTO — a mesma limpeza da apresentação (Bloco U, etapa 3). Nenhuma rota
  // pública devolve os dois: o aluno recebe só o player assinado, na etapa 4.
  // O progresso do aluno fica preso à AULA, nunca a este id (bunny.md §7.1).
  bunnyVideoId         String?
  bunnyVideoPendingId  String?
  // O Bunny já disse que o vídeo está pronto (decisão do operador, 29/09/2026: ao
  // voltar para o editor, a aula pronta volta recolhida). É um LEMBRETE do que o
  // Bunny respondeu, não um dado derivado: sem ele, abrir o editor perguntaria ao
  // Bunny por todas as aulas, toda vez.
  bunnyVideoReady      Boolean          @default(false)
  // A duração do vídeo em segundos (o `length` do Bunny), gravada quando ele fica
  // pronto; a do curso é a soma, nunca coluna (29/09/2026).
  videoDurationSeconds Int?
  // Prévia grátis (operador, 27/09/2026, "como na Udemy"): a aula toca para
  // qualquer visitante. Só é gravada aqui; tocar para visitante é a etapa 4.
  isFreePreview        Boolean          @default(false)
  files                LessonFile[]
  tags                 String[]         @default([])
  displayOrder         Int              @default(0)
  status               ContentStatus    @default(DRAFT)
  planItems            PlanItem[]
  progress             LessonProgress[]
  saved                SavedItem[]
  caption              Caption?
  events               LessonEvent[]

  @@index([moduleId])
  @@map("lesson")
}

// O PROGRESSO do aluno numa aula (Fase 5 — plano aprovado pelo operador em
// 03/10/2026). Uma linha por pessoa e aula; a aula conta como concluída sozinha:
// vídeo ao chegar a 90%, texto ao abrir. Preso à AULA, nunca ao vídeo do Bunny
// (bunny.md §7.1). CHURN NÃO APAGA: perder o acesso não toca nestas linhas
// (CLAUDE.md → Membership Gating); só some com a aula ou com a pessoa.
model LessonProgress {
  id              Int       @id @default(autoincrement())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        Int
  lesson          Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  completed       Boolean   @default(false)
  completedAt     DateTime?
  // ONDE A PESSOA PAROU (Bloco AULA — plano aprovado pelo operador em 06/10/2026):
  // quem sai e volta — no mesmo aparelho ou em outro, amanhã ou daqui a um ano —
  // abre a MESMA aula, no MESMO segundo. Fica na CONTA, e não no navegador: o
  // Safari apaga o que o site guarda no aparelho depois de 7 dias sem visita.
  // `positionSeconds`: o segundo do vídeo; vazio = viu até o fim (ou aula sem
  // vídeo). `lastSeenAt`: a última vez que a pessoa esteve na aula — é o que diz
  // em que aula ela entra quando volta ao curso. Por isso a linha pode existir
  // SEM estar concluída: quem lê conclusão filtra `completed: true`.
  positionSeconds Int?
  lastSeenAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([userId, lessonId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// OS AVISOS DA STRIPE JÁ PROCESSADOS (Fase 4, etapa 4.1 — CLAUDE.md → Membership Gating). A
// Stripe entrega o mesmo aviso mais de uma vez: o repetido não faz nada. O id é o `event.id`
// da Stripe; a linha nasce na MESMA transação que atualiza o espelho da assinatura — se a
// atualização falhar, o aviso não fica marcado e a Stripe entrega de novo.
model StripeEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@map("stripe_event")
}

// O CLIENTE DA STRIPE DE CADA CONTA (Fase 4, etapa 4.2 — billing.md). Uma conta é sempre UM
// cliente na Stripe: sem esta linha, cada tentativa de assinar criaria um cliente novo, e a
// tela de "minha assinatura" (etapa 4.6) não teria de quem buscar cartão e faturas. Não fica no
// `User` (identidade) nem na `Subscription` (que só nasce com o aviso da Stripe, depois do
// cliente). `livemode`: cliente do modo de teste não existe na conta de verdade — no GO-LIVE,
// os de teste saem do banco de produção junto com as assinaturas de teste (plano, Fase 7).
model StripeCustomer {
  userId           String   @id
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stripeCustomerId String   @unique
  livemode         Boolean
  createdAt        DateTime @default(now())

  @@map("stripe_customer")
}

// A FICHA DE ESPERA DO VISITANTE (Fase 4, etapa 4.7, passo 4 — billing.md → *Assinar sem conta*).
// Quem assina sem conta deixa aqui o e-mail, ligado a UM cliente da Stripe — a conta só nasce
// quando a Stripe diz que o pagamento passou, na rotina que grava o espelho (`assinaturas.ts`),
// e então `userId` deixa de ser vazio. O CPF ou CNPJ NÃO mora aqui: fica no cliente da Stripe
// (decisão de 12/10/2026 — um dado pessoal a menos no banco da escola). O consentimento de
// novidades e a origem (UTM) vão na ASSINATURA da Stripe, presos à tentativa que foi paga — e,
// desde o passo 9, a ficha também guarda os da ÚLTIMA tentativa, com o nome (para o lembrete e o lead).
// `tentativa`: o RESUMO (SHA-256, hexadecimal) do código da tentativa de assinar em andamento —
// o código vai só ao navegador de quem a criou, e é só com ele que a tela de depois do pagamento
// pergunta se valeu; aqui fica só o resumo (etapa 4.7, passo 6b — `lib/tentativa-do-visitante.ts`).
// Muda a cada tentativa nova. `livemode`: como em `StripeCustomer`. Some com a conta (cascade).
model GuestCheckout {
  id               String   @id
  email            String   @unique
  stripeCustomerId String   @unique
  livemode         Boolean
  tentativa        String?  @unique
  userId           String?  @unique
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // O e-mail de boas-vindas (etapa 4.7, passo 5): quando ele foi tomado para sair — UMA vez. Se o
  // envio falha, volta a vazio, e o próximo aviso da Stripe tenta de novo.
  boasVindasEnviadaEm DateTime?
  // A senha logo depois de pagar (etapa 4.7, passo 5 — revisão de segurança, 21/10/2026): quando a
  // tentativa criou a senha — UMA vez. Não se deduz da linha de senha: o Better Auth a apaga quando o
  // dono do e-mail entra pelo código pela primeira vez.
  senhaCriadaEm    DateTime?
  // QUEM NÃO TERMINOU DE ASSINAR (etapa 4.7, passo 9 — decisões do operador, 29/10/2026): o que a
  // ÚLTIMA tentativa deixou — o nome digitado, a caixa de novidades e a origem (o UTM do primeiro
  // acesso) — e quando ela foi feita. Daqui saem o lembrete (2 horas depois), o lead e a limpeza (7
  // dias depois). O NOME NUNCA VAI PARA A STRIPE: a fatura anulada guarda o que for para lá, e a Stripe
  // não deixa apagá-la (medido em 30/10/2026). A conta que nasce do pagamento leva este nome.
  nome                String?
  novidades           Boolean   @default(false)
  acquisitionSource   String?
  acquisitionCampaign String?
  ultimaTentativaEm   DateTime  @default(now())
  // O lembrete "você não terminou a assinatura" — UM por ficha: quando foi TOMADO para sair e quando o
  // Resend CONFIRMOU. Tomado e sem confirmação há mais de 15 minutos é retomado (quem o tomou caiu no
  // meio), como a marca dos e-mails da cobrança (`subscription_email`).
  lembreteTomadoEm    DateTime?
  lembreteEnviadoEm   DateTime?
  // A limpeza dos 7 dias achou pagamento na Stripe e NÃO apagou: o alerta saiu nesta hora — uma vez só.
  naoApagadaEm        DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("guest_checkout")
}

// DE ONDE VEIO O LEAD (etapa 4.7, passo 9). O YouTube e o LinkedIn entram depois, com a captura deles.
enum OrigemDoLead {
  // Marcou "Quero receber novidades" ao assinar sem conta, e não terminou de assinar.
  CAIXA_AO_ASSINAR
  // Clicou em "Quero receber novidades" no lembrete de quem não terminou de assinar.
  LEMBRETE
}

// OS LEADS (etapa 4.7, passo 9 — decisões do operador, 29/10/2026): quem aceitou receber novidades da
// escola sem ser aluno — NOME E E-MAIL, NUNCA O CPF. Um por e-mail (em minúsculas). `confirmadoEm`: quando
// o e-mail foi PROVADO — a pessoa clicou num link que a escola mandou àquela caixa; a caixa marcada no
// formulário não prova (P96). `descadastradoEm`: vazio = recebe novidades. O id não é sequencial: ele vai
// no link de descadastrar, e um número publicaria quantos leads a escola tem.
model Lead {
  id                  String       @id
  email               String       @unique
  nome                String?
  origem              OrigemDoLead
  consentimentoEm     DateTime
  confirmadoEm        DateTime?
  descadastradoEm     DateTime?
  acquisitionSource   String?
  acquisitionCampaign String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@map("lead")
}

// OS EVENTOS DO VÍDEO (Fase 5, Bloco MEDIR, etapa 1 — pedido do operador, 09/10/2026).
// Só GUARDA: tocou, pausou, terminou, no segundo do vídeo e na hora — a análise (as
// horas assistidas do cartão do admin) é leitura à parte, em rota própria (CLAUDE.md →
// Analytics Convention). Some com a aula, ou com a pessoa APAGADA de vez (cascade) — o
// soft-delete (`deletedAt`) não apaga: a exclusão a pedido (Fase 7, LGPD) apaga os eventos
// junto. NUNCA some com o churn (CLAUDE.md → Churn não apaga nada). Teto por pessoa na rota. O admin não grava: assistir para conferir não conta como aluno.
// SEEK fica de fora até uma análise pedir (acrescentar ao enum é uma linha de migration).
enum LessonEventType {
  PLAY
  PAUSE
  ENDED
}

model LessonEvent {
  id              Int             @id @default(autoincrement())
  userId          String
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  lessonId        Int
  lesson          Lesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type            LessonEventType
  positionSeconds Int
  createdAt       DateTime        @default(now())

  @@index([lessonId, createdAt])
  @@index([userId, lessonId, createdAt])
  @@map("lesson_event")
}

// AS PREFERÊNCIAS DO ALUNO (Bloco AULA, etapa 6 — decisão do operador, 07/10/2026,
// "como no LinkedIn"): a LEGENDA começa desligada; o aluno liga no CC do próprio
// player, e ela continua ligada nas próximas aulas e ao sair e voltar, em qualquer
// aparelho, até ele desligar no mesmo CC. Uma linha por pessoa, criada na primeira
// mudança; sem linha, vale o padrão. Fora do `User`, que fica só com identidade
// (CLAUDE.md → Access Architecture). Some com a pessoa.
model StudentPreference {
  userId     String   @id
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  captionsOn Boolean  @default(false)
  updatedAt  DateTime @updatedAt

  @@map("student_preference")
}

// O que a pessoa SALVOU para assistir depois — um curso inteiro ou uma aula
// (decisão do operador, 03/10/2026, "como no LinkedIn"; a lista é "Salvos", em
// Meus estudos). Exatamente UM dos dois: o banco recusa os dois juntos ou nenhum
// (CHECK na migration, como no plan_item). Some com o curso, a aula ou a pessoa.
model SavedItem {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  Int?
  course    Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId  Int?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
  @@unique([userId, lessonId])
  @@index([courseId])
  @@index([lessonId])
  @@map("saved_item")
}

// A LEGENDA de uma aula ou da apresentação do curso (passo Legendas do editor —
// decisões do operador, 04/10/2026). Exatamente UM dono: o banco recusa os dois
// ou nenhum (CHECK na migration). O player toca a legenda que está no BUNNY; esta
// é a CÓPIA do site, e é ela que deixa trocar o vídeo sem perder a legenda (o
// site reenvia para o vídeo novo), abrir a tela sem perguntar ao Bunny aula por
// aula, e baixar. Só no idioma do curso. Some com a aula ou o curso.
model Caption {
  id           Int      @id @default(autoincrement())
  lessonId     Int?     @unique
  lesson       Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // A da apresentação do curso.
  courseId     Int?     @unique
  course       Course?  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  content      String
  originalName String
  // O vídeo foi trocado e o Bunny recusou receber esta legenda no vídeo novo: a
  // tela pede para enviar de novo, em vez de a legenda sumir em silêncio.
  needsResend  Boolean  @default(false)
  uploadedAt   DateTime @default(now())

  @@map("caption")
}

// Uma NOTIFICAÇÃO do sino (Bloco E, etapa 4 — decisões do operador, 04/10/2026).
// O texto é COPIADO no envio: editar a mensagem do curso depois não muda o que o
// aluno já recebeu. Uma de cada tipo por pessoa e curso (o banco garante: abrir a
// aula dez vezes não manda dez boas-vindas). Boas-vindas e parabéns têm curso
// (CHECK na migration). Some com a pessoa ou o curso.
model Notification {
  id          Int              @id @default(autoincrement())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        NotificationKind
  courseId    Int?
  course      Course?          @relation(fields: [courseId], references: [id], onDelete: Cascade)
  body        String
  // O título do curso NO ENVIO, como o texto: o curso pode sair do ar e ser
  // renomeado em rascunho, e o nome novo não pode vazar pelo sino (achado P1 da
  // revisão de segurança, 04/10/2026).
  courseTitle String?
  createdAt   DateTime         @default(now())
  readAt      DateTime?

  // O aviso de Comunicação de onde esta notificação veio (só no tipo AVISO). O sino
  // lê o título e o texto ATUAIS dele (regra da P46); apagar o aviso apaga daqui.
  announcementId Int?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, kind])
  @@unique([userId, announcementId])
  @@index([userId, createdAt])
  @@index([courseId])
  @@index([announcementId])
  @@map("notification")
}

// O AVISO de Comunicação → Notificações (bloco C1 — decisões do operador, 06/10/2026):
// o operador escreve, escolhe para quem, salva como rascunho ou envia. Enviado,
// pode ser editado (todos passam a ver o texto novo) e apagado (some do sino de
// todos). `sentAt` nulo = rascunho.
model Announcement {
  id            Int                  @id @default(autoincrement())
  title         String
  body          String
  audience      AnnouncementAudience @default(TODOS)
  courseId      Int?
  course        Course?              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  sentAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  notifications Notification[]

  @@index([courseId])
  @@map("announcement")
}

// QUEM JÁ COMEÇOU O CURSO (decisão do operador, 06/10/2026): a escola não tem
// matrícula — a assinatura dá acesso a tudo —, então "os alunos de um curso" são
// os que abriram uma aula dele com acesso. Gravado na página da aula; a primeira
// vez fica.
model CourseStart {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  Int
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  startedAt DateTime @default(now())

  @@unique([userId, courseId])
  @@index([courseId])
  @@map("course_start")
}

// A trilha (learning track). Curated template (ownerUserId = null, isTemplate)
// and a member's personalized/cloned plan are the SAME entity — only ownership
// differs. AI-assembled plans (buildLearningPlan) land in JilsonAI Fase 4–5 with
// no rewrite. skillsCovered is the snapshot the certificate prints.
model LearningPlan {
  id            Int            @id @default(autoincrement())
  slug          String?        @unique // curated templates get a slug; clones may not
  name          String
  description   String?
  ownerUserId   String? // null = curated template
  owner         User?          @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  isTemplate    Boolean        @default(false)
  skillsCovered String[]       @default([])
  sourcePlanId  Int? // provenance: which template this clone came from
  sourcePlan    LearningPlan?  @relation("PlanClone", fields: [sourcePlanId], references: [id], onDelete: SetNull)
  clones        LearningPlan[] @relation("PlanClone")
  displayOrder  Int            @default(0)
  status        ContentStatus  @default(DRAFT)
  // A trilha segue o idioma (operador, 14/09): o servidor recusa item de outro
  // idioma. Obrigatório e sem default, como no curso.
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  planModules   PlanModule[]

  @@index([ownerUserId])
  @@map("learning_plan")
}

model PlanModule {
  id           Int          @id @default(autoincrement())
  planId       Int
  plan         LearningPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  title        String
  displayOrder Int          @default(0)
  items        PlanItem[]

  @@index([planId])
  @@map("plan_module")
}

// The free mix: an item is EITHER a whole course OR a standalone lesson. A DB
// CHECK constraint (added in the migration) enforces the XOR so itemType always
// matches exactly one populated FK.
model PlanItem {
  id           Int          @id @default(autoincrement())
  planModuleId Int
  planModule   PlanModule   @relation(fields: [planModuleId], references: [id], onDelete: Cascade)
  itemType     PlanItemType
  courseId     Int?
  course       Course?      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId     Int?
  lesson       Lesson?      @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  displayOrder Int          @default(0)

  @@index([planModuleId])
  @@index([courseId])
  @@index([lessonId])
  @@map("plan_item")
}

// ARQUIVO PARA BAIXAR de uma aula (Bloco E, etapa 2, parte 2e — decisão do
// operador, 28/09/2026). O arquivo mora numa Storage Zone PRÓPRIA do Bunny, sem
// CDN: nada lá é público, e só o nosso servidor entrega — para o assinante, na
// etapa 4 do Bloco U. O caminho tem nome aleatório (`aulas/<aula>/<código>.<ext>`).
//
// Bloco G, etapa G2: o envio pelo admin vai em partes de até 30 MB para caber
// no limite de pedido do Cloud Run; cada parte vira um objeto no Bunny Storage
// (`aulas/<aula>/<código>.<ext>` na primeira e `.parte-2`, `.parte-3`... nas
// seguintes). O arquivo já guardado inteiro vale como 1 parte pronta, e o
// arquivo novo só aparece para o aluno quando todas as partes chegaram (`completo`).
model LessonFile {
  id             Int      @id @default(autoincrement())
  lessonId       Int
  lesson         Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  // O nome com que o operador enviou (o aluno baixa com este nome).
  originalName   String
  storagePath    String   @unique
  // BigInt: arquivo sem limite de tamanho (operador, 29/09/2026); Int para em 2 GB.
  sizeBytes      BigInt
  partes         Int      @default(1)
  partesEnviadas Int      @default(1)
  completo       Boolean  @default(true)
  createdAt      DateTime @default(now())

  @@index([lessonId])
  @@map("lesson_file")
}

// A ASSINATURA — o ESPELHO local da Subscription da Stripe, que é a canônica
// (CLAUDE.md → Membership Gating). O gate (`temAcessoAtivo`) lê SÓ daqui. Nasce
// na etapa 4 do Bloco U (29/09/2026), adiantada da Fase 4 e ainda sem Stripe: as
// colunas da Stripe já nascem, porque o espelho é delas. Costuras do corporativo
// desde o primeiro dia (`organizationId`, `seats`) e SEM coluna de idioma —
// idioma é filtro, nunca portão (decisão do operador, 14/09/2026).
model Subscription {
  id                   Int       @id @default(autoincrement())
  ownerUserId          String?
  owner                User?     @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  // Sempre vazio antes do corporativo (pós-MVP).
  organizationId       Int?
  seats                Int       @default(1)
  // TEXTO, não enum: a regra do gate não pode quebrar no dia em que a Stripe
  // inventar um status novo (CLAUDE.md → Membership Gating).
  status               String
  currentPeriodEnd     DateTime?
  stripeCustomerId     String?
  // Obrigatório: é a chave do objeto canônico na Stripe.
  stripeSubscriptionId String    @unique
  // Assinatura de verdade ou do MODO DE TESTE da Stripe (Fase 4, etapa 4.1 — achado P2 da
  // revisão, 09/10/2026). Até o lançamento o site no ar usa as chaves de teste; no GO-LIVE, as
  // de teste saem do banco de produção (Fase 7), senão dariam acesso para sempre. Sem saber
  // (a assinatura de teste do seed), FALSO.
  livemode             Boolean   @default(false)
  // O PIX PRÉ-PAGO (etapa 4.9, 28/10/2026): o pagamento Pix (solto, na Stripe) que esta assinatura
  // nasceu para representar — paga por fora, cancela no fim do período, nunca renova. Vazio =
  // assinatura recorrente (cartão). É por esta coluna que as telas, a rodada e o reembolso sabem
  // que ela é pré-paga; e é única: um Pix vira UMA assinatura (a idempotência do aviso).
  pixPaymentIntentId   String?   @unique
  // O PAINEL DA COBRANÇA (etapa 4.7b, passo 1a — 31/10/2026): o que a lista do admin mostra e filtra
  // sem ir à Stripe a cada linha. Gravados pela MESMA rotina do resto (`sincronizar`), com o que a
  // Stripe diz agora; o GATE NÃO LÊ NENHUM DELES (ele lê `status` e `currentPeriodEnd`). Uma linha de
  // antes desta coluna fica vazia até a próxima sincronia (um aviso, a renovação, o "Conferir").
  // `plan`: o plano do PREÇO de agora (muda quando o aluno troca de plano) — vazio quando o preço não
  // é de nenhum dos dois. `cancelAt`: marcada para acabar nesta data (vazio = renova); a pré-paga do
  // Pix sempre tem, porque nunca renova. `promotionCode`: o código que o aluno digitou, como a Stripe
  // o guarda (vazio = sem código).
  plan                 PlanoDaAssinatura?
  cancelAt             DateTime?
  promotionCode        String?
  // O motivo que o aluno escolheu ao cancelar (`metadata.motivo` na Stripe — os valores de `MOTIVOS_DE_CANCELAMENTO`
  // do `core`), para o painel contar (passo 1f). Some quando ele volta atrás. Vazio = sem motivo, ou não cancelou.
  cancelReason         String?
  // PAGA POR FORA pelo operador (etapa 4.7b, passo 4d — P120: "Liberar acesso pago por fora"): pré-paga como a do Pix,
  // sem Pix — não renova e não tem cartão. Vem da marca `pago_por_fora` nos metadados da assinatura (`METADADO_PAGO_POR_FORA`).
  paidOutOfBand        Boolean   @default(false)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  // Os e-mails da cobrança já tomados para esta assinatura (etapa 4.7, passo 7).
  emails               SubscriptionEmail[]

  @@index([ownerUserId])
  @@map("subscription")
}

// O REGISTRO DA COBRANÇA (etapa 4.7b, passo 1f — o mapa aprovado pelo operador, 31/10/2026): TUDO o que aconteceu na
// cobrança, de quem fez — a Stripe (cada aviso processado), o operador, o aluno, a rodada de hora em hora e, no futuro,
// o JilsonAI —, quando, em quem e o quê. É o que deixa o operador acompanhar e a automação agir sabendo o que já foi
// feito. Só ACRESCENTA: nada aqui decide acesso, e nada se apaga com o churn. Sem dado pessoal além da ligação com a
// conta: ids, valores e status. Apagada a conta (a exclusão a pedido, Fase 7), a linha fica sem dono (SetNull).
model BillingLog {
  id                   Int      @id @default(autoincrement())
  createdAt            DateTime @default(now())
  who                  QuemFez
  // A conta de quem fez, quando foi uma pessoa (o operador ou o aluno). Vazio para a Stripe e a rodada.
  actorUserId          String?
  // O que aconteceu: o tipo do aviso da Stripe (`invoice.paid`…) ou o nome da ação (blocos 3 a 5). Texto, e não enum:
  // o vocabulário da Stripe é dela, e não pode quebrar o registro no dia em que ela inventar um tipo.
  action               String
  // O aviso da Stripe que gerou a linha: um aviso, uma linha (a reentrega não repete).
  stripeEventId        String?  @unique
  userId               String?
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  stripeSubscriptionId String?
  stripeCustomerId     String?
  // O valor envolvido, em centavos (a contestação, a devolução), quando se sabe.
  amount               Int?
  // O resumo em poucas palavras, sem dado pessoal: o status de depois, o motivo, a fase.
  detail               String?

  @@index([userId, createdAt])
  @@index([stripeSubscriptionId, createdAt])
  @@index([createdAt])
  @@map("billing_log")
}

// A CORREÇÃO DO E-MAIL pedida pelo admin (etapa 4.7b, passo 3c — decisão do operador, 29/10/2026, P121: "com o código
// no e-mail novo"): o código vai ao e-mail NOVO, e a troca só vale com ele (`lib/correcao-de-email.ts`). Um pedido por
// conta — o novo substitui o anterior —, apagado quando a troca vale ou quando as tentativas acabam. Guardado só o
// resumo do código, nunca o número.
model EmailCorrection {
  userId      String   @id
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // O e-mail novo, em minúsculas.
  newEmail    String
  codeHash    String
  attempts    Int      @default(0)
  expiresAt   DateTime
  // A conta do admin que pediu.
  requestedBy String
  createdAt   DateTime @default(now())

  @@map("email_correction")
}

// OS CASOS — "PRECISA DE VOCÊ" (etapa 4.7b, bloco 2 — o mapa aprovado pelo operador, 31/10/2026): cada situação da
// cobrança que precisa do operador (hoje um alerta que pede o painel da Stripe) vira UM caso — um por situação (`kind` +
// `key`), sem repetir; se a situação volta depois de resolvida, o mesmo caso REABRE. Fecha sozinho quando a situação se
// resolve, ou pelo operador, com uma nota. É o que o operador (e, no futuro, o JilsonAI) atende. Nada aqui decide acesso.
// `userId` SEM chave estrangeira, de propósito: o caso é aberto DENTRO das transações da cobrança, e nada ali pode falhar
// por causa dele (`lib/casos.ts` grava num comando só, que não falha se o caso já existe).
model BillingCase {
  id                   Int        @id @default(autoincrement())
  kind                 TipoDeCaso
  // O que identifica a situação: `pix:<pi_…>`, `sub:<sub_…>`, `ficha:<id>`…
  key                  String
  open                 Boolean    @default(true)
  // O que pede o aviso na hora (P137): quem pagou e está sem acesso, e a contestação (tem prazo).
  urgent               Boolean    @default(false)
  userId               String?
  stripeSubscriptionId String?
  stripeCustomerId     String?
  // O objeto da Stripe em questão (o Pix, a cobrança, a contestação…).
  stripeObjectId       String?
  amount               Int?
  // O resumo em poucas palavras, sem dado pessoal.
  detail               String?
  openedAt             DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  closedAt             DateTime?
  closedBy             QuemFez?
  closedByUserId       String?
  // A nota de quem fechou.
  note                 String?
  // Quando o operador foi avisado por e-mail (passo 2d); vazio = ainda não.
  notifiedAt           DateTime?

  @@unique([kind, key])
  @@index([open, openedAt])
  @@map("billing_case")
}

// O TIPO DE CASO (etapa 4.7b, bloco 2 — a lista B do mapa).
enum TipoDeCaso {
  PIX_EM_CONFERENCIA
  PAGO_SEM_ASSINATURA
  PAGOU_SEM_CONTA
  DIVERGENCIA
  ATIVA_SEM_PERIODO_PAGO
  COBRANCA_EM_ABERTO
  DEVOLUCAO_FALHOU
  TROCA_DE_PLANO
  CONTESTACAO
  AVISO_DE_FRAUDE
  EMAIL_NAO_SAIU
  PEDIDO_DE_REEMBOLSO
}

// QUEM FEZ o que está no registro da cobrança (etapa 4.7b, passo 1f).
enum QuemFez {
  STRIPE
  OPERADOR
  ALUNO
  RODADA
  JILSONAI
}

// O PLANO DE UMA ASSINATURA no espelho (etapa 4.7b, passo 1a). Os mesmos nomes do `Plano` do `core`.
enum PlanoDaAssinatura {
  mensal
  anual
}

// OS E-MAILS DA COBRANÇA (Fase 4, etapa 4.7, passo 7 — decisões do operador, 28/10/2026): a marca
// de que um deles foi TOMADO para sair — UMA vez cada (`avisos-da-assinatura.ts`). Quem toma é
// quem cria a linha (a única); se o envio falha, a linha sai, e a vez seguinte tenta de novo.
// Não é o espelho: nada aqui decide acesso.
model SubscriptionEmail {
  id             Int                   @id @default(autoincrement())
  subscriptionId Int
  subscription   Subscription          @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  kind           SubscriptionEmailKind
  // A que o e-mail se refere: nos da cobrança que falhou, o instante da falha (o "pago até" da
  // atrasada, em ISO) — uma falha nova é outro e-mail; no de cancelada, "fim": ela só termina uma vez.
  reference      String
  // Quando a marca foi TOMADA (e, numa retomada, quando foi retomada): é o prazo da pendente.
  createdAt      DateTime              @default(now())
  // Quando o envio foi CONFIRMADO pelo Resend — ou a decisão de nunca enviar (a conta que já assinou
  // de novo, a excluída). VAZIO = PENDENTE: tomada e sem confirmação; pendente há mais de 15 minutos é
  // retomada pela vez seguinte (quem a tomou caiu no meio — revisão da etapa 4.7, 28/10/2026).
  sentAt         DateTime?

  @@unique([subscriptionId, kind, reference])
  @@map("subscription_email")
}

enum SubscriptionEmailKind {
  // Na falha da renovação: a próxima tentativa e até quando as aulas ficam abertas.
  COBRANCA_FALHOU
  // No último dia antes de as aulas trancarem.
  ANTES_DE_TRANCAR
  // No fim de uma assinatura que foi paga.
  CANCELADA
  // Na PRÉ-PAGA (Pix, etapa 4.9): 3 dias antes de o acesso acabar (decisão do operador, 28/10/2026).
  PREPAGO_TERMINANDO
  // A confirmação de quem assinou logado, uma vez por assinatura (4.9b, E18 — decisão do operador, P127).
  CONFIRMADA
}

// A CONTAGEM DO LIMITE DE TENTATIVAS (25/10/2026 — o servidor passa a ter até 3 cópias): uma linha
// por chave (o limitador + quem pediu), com a contagem da janela e quando ela zera. Na memória, cada
// cópia contava sozinha. Só o `lib/loja-de-tentativas.ts` escreve aqui, por SQL atômico.
model LimiteDeTentativa {
  chave    String   @id
  contagem Int
  zeraEm   DateTime @map("zera_em") @db.Timestamptz(3)

  @@index([zeraEm])
  @@map("limite_de_tentativa")
}

