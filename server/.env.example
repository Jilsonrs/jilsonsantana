# ⚠️ AS DUAS URLS USAM O POOLER. NUNCA use o host "Direct connection" do painel
# (db.<ref>.supabase.co) — ele é IPv6-only e fica INALCANÇÁVEL em qualquer rede
# sem rota IPv6, com um erro que se disfarça de senha errada. No painel:
# Connect → Transaction pooler (6543) e Session pooler (5432), NÃO a aba Direct.
# Repare que o usuário do pooler é `postgres.<ref>`, não `postgres`.
# (Custou uma sessão inteira de diagnóstico em Ago 2026 — o comentário antigo
# aqui dizia "Direct (non-pooled)" apontando para uma URL de pooler.)

# Transaction pooler (6543) — usado em runtime pela app
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1

# Session pooler (5432) — usado por `prisma migrate` e `db pull`
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-us-east-2.pooler.supabase.com:5432/postgres

PORT=3000
NODE_ENV=development

# Better Auth — server-side auth (Bloco 2)
# Secret used to sign sessions/cookies. Generate with one of:
#   openssl rand -base64 32
#   npx @better-auth/cli secret
BETTER_AUTH_SECRET=GENERATE_A_32_BYTE_SECRET
# Base URL the auth server runs on (used for cookies + callbacks).
BETTER_AUTH_URL=http://localhost:3000
# Frontend origin, added to Better Auth trustedOrigins (CSRF allow-list).
# Dev: the Vite client at :5173 (proxies /api to :3000).
CLIENT_URL=http://localhost:5173

# Seed credentials (Bloco 3) — used ONLY by `npm run db:seed`, never committed.
# The admin (Jilson) is required; the test member is optional (omit to skip it).
# Passwords must be >= 8 chars (Better Auth default minimum).
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CHANGE_ME_min_8_chars
SEED_MEMBER_EMAIL=member@example.com
SEED_MEMBER_PASSWORD=CHANGE_ME_min_8_chars
